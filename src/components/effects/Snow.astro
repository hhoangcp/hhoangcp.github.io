---

---

<canvas id="fx-snow" aria-hidden="true" transition:persist></canvas>
<script>
  if (!(window as any).__snow) {
    (window as any).__snow = true;
    const canvas = document.getElementById('fx-snow') as HTMLCanvasElement | null;
    if (canvas && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      const ctx = canvas.getContext('2d')!;
      let w = 0,
        h = 0,
        dpr = Math.min(window.devicePixelRatio || 1, 2);
      const COUNT = window.innerWidth < 760 ? 28 : 60;
      type P = {
        x: number;
        y: number;
        r: number;
        vy: number;
        vx: number;
        sway: number;
        phase: number;
        a: number;
      };
      let flakes: P[] = [];
      function resize() {
        w = window.innerWidth;
        h = window.innerHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        canvas.style.width = w + 'px';
        canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      function spawn(initial = false): P {
        const big = Math.random() < 0.3;
        return {
          x: Math.random() * w,
          y: initial ? Math.random() * h : -12,
          r: big ? 4 + Math.random() * 4 : 1.5 + Math.random() * 2,
          vy: big ? 0.25 + Math.random() * 0.4 : 0.4 + Math.random() * 0.8,
          vx: (Math.random() - 0.5) * 0.4,
          sway: 0.5 + Math.random() * 1.1,
          phase: Math.random() * Math.PI * 2,
          a: 0.5 + Math.random() * 0.45,
        };
      }
      function drawFlake(p: P) {
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r);
        g.addColorStop(0, `rgba(250,250,250,${p.a})`);
        g.addColorStop(0.55, `rgba(250,250,250,${p.a * 0.5})`);
        g.addColorStop(1, 'rgba(250,250,250,0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      let t = 0;
      function frame() {
        t += 0.016;
        ctx.clearRect(0, 0, w, h);
        for (const p of flakes) {
          p.y += p.vy;
          p.x += p.vx + Math.sin(t + p.phase) * p.sway * 0.5;
          if (p.y > h + 12) Object.assign(p, spawn(false));
          drawFlake(p);
        }
        requestAnimationFrame(frame);
      }
      resize();
      flakes = Array.from({ length: COUNT }, () => spawn(true));
      window.addEventListener('resize', resize, { passive: true });
      frame();
    }
  }
</script>
