---
import { SITE } from '../consts';
---

<canvas id="fx-sakura" aria-hidden="true" transition:persist></canvas>
<script>
  if (!(window as any).__sakura) {
    (window as any).__sakura = true;
    const canvas = document.getElementById('fx-sakura') as HTMLCanvasElement | null;
    if (canvas && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      const ctx = canvas.getContext('2d')!;
      let w = 0,
        h = 0,
        dpr = Math.min(window.devicePixelRatio || 1, 2);
      const COUNT = window.innerWidth < 760 ? 14 : 28;
      type P = {
        x: number;
        y: number;
        s: number;
        r: number;
        rs: number;
        vy: number;
        vx: number;
        sway: number;
        phase: number;
        color: string;
      };
      const colors = ['#ffd1e3', '#ffc1d9', '#ffb6d5', '#ffe0ec', '#f9b5c9'];
      let petals: P[] = [];
      function resize() {
        w = window.innerWidth;
        h = window.innerHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        canvas.style.width = w + 'px';
        canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      function spawn(initial = false): P {
        return {
          x: Math.random() * w,
          y: initial ? Math.random() * h : -20,
          s: 6 + Math.random() * 8,
          r: Math.random() * Math.PI,
          rs: (Math.random() - 0.5) * 0.04,
          vy: 0.4 + Math.random() * 0.9,
          vx: (Math.random() - 0.5) * 0.6,
          sway: 0.6 + Math.random() * 0.8,
          phase: Math.random() * Math.PI * 2,
          color: colors[(Math.random() * colors.length) | 0],
        };
      }
      function drawPetal(p: P) {
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.r);
        ctx.fillStyle = p.color;
        ctx.globalAlpha = 0.8;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.quadraticCurveTo(p.s * 0.5, -p.s * 0.7, 0, -p.s);
        ctx.quadraticCurveTo(-p.s * 0.5, -p.s * 0.7, 0, 0);
        ctx.fill();
        ctx.restore();
      }
      let t = 0;
      function frame() {
        t += 0.016;
        ctx.clearRect(0, 0, w, h);
        for (const p of petals) {
          p.y += p.vy;
          p.x += p.vx + Math.sin(t + p.phase) * p.sway * 0.4;
          p.r += p.rs;
          if (p.y > h + 20) Object.assign(p, spawn(false));
          drawPetal(p);
        }
        requestAnimationFrame(frame);
      }
      resize();
      petals = Array.from({ length: COUNT }, () => spawn(true));
      window.addEventListener('resize', resize, { passive: true });
      frame();
    }
  }
</script>
