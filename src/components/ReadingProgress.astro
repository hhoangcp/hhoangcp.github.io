<div class="reading-progress" id="reading-progress" aria-hidden="true">
  <div class="reading-progress-bar" id="reading-progress-bar"></div>
</div>

<script>
  if (!(window as any).__rpInit) {
    (window as any).__rpInit = true;
    function update() {
      const bar = document.getElementById('reading-progress-bar');
      const wrap = document.getElementById('reading-progress');
      const target = document.querySelector('.post-main, .post-content');
      if (!bar || !target) {
        if (wrap) wrap.style.display = 'none';
        return;
      }
      const rect = target.getBoundingClientRect();
      const top = rect.top + window.scrollY;
      const height = rect.height;
      const viewH = window.innerHeight;
      const scrolled = window.scrollY + viewH * 0.15 - top;
      const total = height - viewH * 0.3;
      const p = total <= 0 ? 1 : Math.min(1, Math.max(0, scrolled / total));
      bar.style.transform = `scaleX(${p})`;
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    document.addEventListener('astro:page-load', update);
  }
</script>
