---
import type { CollectionEntry } from 'astro:content';
import { formatDate, capitalize, slugify, prettyTag } from '../utils';
interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const url = `/posts/${post.id}/`;
const d = post.data;
const cats = d.category.map((c) => ({ name: c, slug: slugify(c) }));
---

<article class="post-card">
  <h2 class="post-card-title"><a href={url}>{d.title}</a></h2>
  <div class="post-card-meta">
    <span class="meta-date">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"
        ></path></svg
      >
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
    </span>
    {
      d.source &&
        (d.sourceUrl ? (
          <a class="src-badge" href={d.sourceUrl} target="_blank" rel="noopener noreferrer">
            {d.source}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 3h7v7M21 3l-9 9M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5" />
            </svg>
          </a>
        ) : (
          <span class="src-badge">{d.source}</span>
        ))
    }
  </div>
  {d.description && <p class="post-card-excerpt">{d.description}</p>}
  {
    cats.length > 0 && (
      <div class="post-card-cats">
        {cats.map((c) => (
          <a class="cat-badge" href={`/category/${c.slug}/`}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.5L10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" />
            </svg>
            {capitalize(c.name)}
          </a>
        ))}
      </div>
    )
  }
  {
    d.tags.length > 0 && (
      <div class="post-card-tags">
        {d.tags.map((t) => (
          <a href={`/tags/${slugify(t)}/`}>{prettyTag(t)}</a>
        ))}
      </div>
    )
  }
</article>
