---
import type { CollectionEntry } from 'astro:content';
import { formatDate, capitalize, slugify, prettyTag, renderInlineMath } from '../utils';
import { TREE_BRANCHES, TREE_NODE_TITLES, TREE_PATH_TITLES } from '../data/tree';
interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const url = `/posts/${post.id}/`;
const d = post.data;
// Badge: sub-category (node cấp 2 trên cây), fallback về nhánh cấp 1
const tree: string[] = Array.isArray(d.tree) ? d.tree : [];
const subSlug = tree[1];
const branchSlug = tree[0];
const badge = subSlug
  ? (TREE_PATH_TITLES[`${branchSlug}/${subSlug}`] ??
    TREE_NODE_TITLES[subSlug] ??
    subSlug.replace(/[-_]+/g, ' '))
  : branchSlug
    ? (TREE_BRANCHES.find((b) => b.slug === branchSlug)?.title ?? branchSlug)
    : '';
// Có $..$ mới render math (KaTeX/MathJax theo cờ build), không thì giữ text thuần
const titleHtml = await renderInlineMath(d.title);
const descHtml = d.description ? await renderInlineMath(d.description) : null;
---

<article class="post-card">
  <h2 class="post-card-title">
    <a href={url}>{titleHtml ? <Fragment set:html={titleHtml} /> : d.title}</a>
  </h2>
  <div class="post-card-meta">
    <span class="meta-date">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
        <path d="M16 2v4M8 2v4M3 10h18"></path>
      </svg>
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
    </span>
    {d.source &&
      (d.sourceUrl ? (
        <a class="src-badge" href={d.sourceUrl} target="_blank" rel="noopener noreferrer">
          {d.source}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M14 3h7v7M21 3l-9 9M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5" />
          </svg>
        </a>
      ) : (
        <span class="src-badge">{d.source}</span>
      ))}
  </div>
  {d.description && (
    <p class="post-card-excerpt">{descHtml ? <Fragment set:html={descHtml} /> : d.description}</p>
  )}
  {badge && (
    <div class="post-card-cats">
      <a class="cat-badge" href="/category/">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19l7-7 3 3-7 7-3-3z" />
          <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
          <path d="M2 2l7.586 7.586" />
          <circle cx="11" cy="11" r="2" />
        </svg>
        {badge}
      </a>
    </div>
  )}
  {d.tags.length > 0 && (
    <div class="post-card-tags">
      {d.tags.map((t) => (
        <a href={`/tags/${slugify(t)}/`}>{prettyTag(t)}</a>
      ))}
    </div>
  )}
</article>
