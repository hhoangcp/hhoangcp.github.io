---
import type { CollectionEntry } from 'astro:content';
import { formatDate, capitalize } from '../utils';
interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const url = `/posts/${post.id}/`;
const d = post.data;
---

<article class="post-card">
  <h2 class="post-card-title"><a href={url}>{d.title}</a></h2>
  <div class="post-card-meta">
    <span class="meta-date">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"
        ></path></svg
      >
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
    </span>
  </div>
  {d.description && <p class="post-card-excerpt">{d.description}</p>}
  {
    d.tags.length > 0 && (
      <div class="post-card-tags">
        {d.tags.map((t) => (
          <a href={`/tags/${t}/`}>{capitalize(t)}</a>
        ))}
      </div>
    )
  }
</article>
