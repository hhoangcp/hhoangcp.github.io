---

---

<button
  id="theme-toggle"
  class="theme-toggle"
  aria-label="Đổi giao diện sáng/tối"
  title="Sáng / Tối"
>
  <svg
    class="icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  if (!(window as any).__themeInit) {
    (window as any).__themeInit = true;
    document.addEventListener('astro:page-load', () => {
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme') || 'light';
        const next = cur === 'dark' ? 'light' : 'dark';
        const setTheme = () => {
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch {}
        };
        if (document.startViewTransition) {
          const rect = btn.getBoundingClientRect();
          const html = document.documentElement;
          html.style.setProperty('--toggle-x', rect.left + rect.width / 2 + 'px');
          html.style.setProperty('--toggle-y', rect.top + rect.height / 2 + 'px');
          html.style.viewTransitionName = 'theme-root';
          const mainEl = document.querySelector('main');
          if (mainEl) mainEl.style.viewTransitionName = 'none';
          const t = document.startViewTransition(setTheme);
          t.finished.finally(() => {
            html.style.viewTransitionName = '';
            if (mainEl) mainEl.style.viewTransitionName = '';
          });
        } else {
          setTheme();
        }
      });
    });
  }
</script>
