---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import TOC from '../components/TOC.astro';
import Back from '../components/Back.astro';
import { formatDateLong, capitalize } from '../utils';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
---

<Base title={d.title} description={d.description}>
  <div class="container container-wide">
    <article class="post-layout">
      <div class="post-main">
        <Back href="/posts/" />
        <header class="post-header">
          <h1>{d.title}</h1>
          <div class="post-meta">
            <span class="meta-date">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><rect x="3" y="4" width="18" height="18" rx="2"></rect><path
                  d="M16 2v4M8 2v4M3 10h18"></path></svg
              >
              <time datetime={d.date.toISOString()}>{formatDateLong(d.date)}</time>
            </span>
            {
              d.updated && (
                <span class="meta-updated">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                  </svg>
                  <time datetime={d.updated.toISOString()}>{formatDateLong(d.updated)}</time>
                </span>
              )
            }
            <span class="meta-tags">
              {
                d.tags.map((t) => (
                  <a class="tag-link" href={`/tags/${t}/`}>
                    {capitalize(t)}
                  </a>
                ))
              }
            </span>
          </div>
        </header>
        <div class="post-content">
          <Content />
        </div>
      </div>
      <TOC headings={headings} />
    </article>
  </div>
</Base>
