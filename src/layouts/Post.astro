---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import TOC from '../components/TOC.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import {
  formatDateLong,
  capitalize,
  slugify,
  prettyTag,
  getAdjacentPosts,
  getRelatedPosts,
  getAllPosts,
} from '../utils';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const all = await getAllPosts();
const { prev, next } = getAdjacentPosts(post, all);
const related = getRelatedPosts(post, all, 3);
const cats = d.category.map((c) => ({ name: c, slug: slugify(c) }));
const shareUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
---

<Base title={d.title} description={d.description}>
  <ReadingProgress />
  <div class="container container-wide">
    <article class="post-layout">
      <div class="post-main">
        <header class="post-header">
          <h1>{d.title}</h1>
          <div class="post-meta">
            <span class="meta-date">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
              </svg>
              <time datetime={d.date.toISOString()}>{formatDateLong(d.date)}</time>
            </span>
            {d.updated && (
              <span class="meta-updated">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                </svg>
                <time datetime={d.updated.toISOString()}>{formatDateLong(d.updated)}</time>
              </span>
            )}
            {d.source &&
              (d.sourceUrl ? (
                <a class="src-badge" href={d.sourceUrl} target="_blank" rel="noopener noreferrer">
                  {d.source}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M14 3h7v7M21 3l-9 9M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5" />
                  </svg>
                </a>
              ) : (
                <span class="src-badge">{d.source}</span>
              ))}
            {cats.length > 0 && (
              <span class="meta-cats">
                {cats.map((c) => (
                  <a class="cat-badge" href={`/category/${c.slug}/`}>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.5L10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" />
                    </svg>
                    {capitalize(c.name)}
                  </a>
                ))}
              </span>
            )}
            <span class="meta-tags">
              {d.tags.map((t) => (
                <a class="tag-link" href={`/tags/${slugify(t)}/`}>
                  {prettyTag(t)}
                </a>
              ))}
            </span>
          </div>
        </header>
        <div class="post-content">
          <Content />
        </div>
        <section class="post-share" aria-label="Chia sẻ bài viết">
          <span class="post-share-label">Chia sẻ</span>
          <a
            class="share-btn"
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Chia sẻ lên Facebook"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
            </svg>
            <span>Facebook</span>
          </a>
          <a
            class="share-btn"
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(d.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Chia sẻ lên X"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
            </svg>
            <span>X</span>
          </a>
          <a
            class="share-btn"
            href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(d.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Chia sẻ lên Telegram"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"></path>
            </svg>
            <span>Telegram</span>
          </a>
          <button
            class="share-btn share-copy"
            type="button"
            data-url={shareUrl}
            aria-label="Sao chép liên kết bài viết"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <span class="share-copy-text">Sao chép</span>
          </button>
        </section>
        {(prev || next) && (
          <nav class="post-nav" aria-label="Bài kế/trước">
            {prev && (
              <a class="post-nav-item prev" href={`/posts/${prev.id}/`}>
                <span class="post-nav-label">← Bài trước</span>
                <span class="post-nav-title">{prev.data.title}</span>
              </a>
            )}
            {next && (
              <a class="post-nav-item next" href={`/posts/${next.id}/`}>
                <span class="post-nav-label">Bài sau →</span>
                <span class="post-nav-title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )}
        {related.length > 0 && (
          <section class="related-posts">
            <h2 class="related-title">Bài viết liên quan</h2>
            <div class="related-list">
              {related.map((p) => (
                <a class="related-item" href={`/posts/${p.id}/`}>
                  <span class="related-item-title">{p.data.title}</span>
                  <span class="related-item-meta">{formatDateLong(p.data.date)}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
      <TOC headings={headings} />
    </article>
  </div>
</Base>

<script>
  if (!(window as any).__ssInit) {
    (window as any).__ssInit = true;
    let io: IntersectionObserver | null = null;
    document.addEventListener('astro:page-load', () => {
      if (io) {
        io.disconnect();
        io = null;
      }
      const links = document.querySelectorAll<HTMLElement>('.post-toc a[href^="#"]');
      if (!links.length) return;
      const map = new Map<string, HTMLElement>();
      links.forEach((a) => {
        const id = a.getAttribute('href')?.slice(1) || '';
        if (id) map.set(id, a);
      });
      const headings = [...map.keys()]
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => !!el);
      if (!headings.length) return;
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const a = map.get((e.target as HTMLElement).id);
            if (!a) continue;
            links.forEach((l) => l.classList.remove('active'));
            a.classList.add('active');
          }
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );
      headings.forEach((h) => io!.observe(h));
    });
    document.addEventListener('astro:before-swap', () => {
      if (io) {
        io.disconnect();
        io = null;
      }
    });
  }
</script>

<script>
  if (!(window as any).__shareInit) {
    (window as any).__shareInit = true;
    document.addEventListener('click', async (e) => {
      const target = e.target as Element | null;
      const btn = target?.closest?.('.share-copy') as HTMLElement | null;
      if (!btn) return;
      const url = btn.dataset.url || location.href;
      const label = btn.querySelector('.share-copy-text');
      const original = label?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(url);
        btn.classList.add('copied');
        if (label) label.textContent = 'Đã sao chép';
      } catch {
        window.prompt('Sao chép liên kết:', url);
      }
      setTimeout(() => {
        btn.classList.remove('copied');
        if (label) label.textContent = original;
      }, 1600);
    });
  }
</script>
