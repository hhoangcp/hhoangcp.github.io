---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Snow from '../components/effects/Snow.astro';
import ClickRipple from '../components/effects/ClickRipple.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const desc = description || SITE.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image || '/avatar.jpg', Astro.site).href;
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter />
    <script is:inline>
      (function () {
        function apply(doc) {
          try {
            var t = localStorage.getItem('theme') || 'light';
            (doc || document).documentElement.setAttribute('data-theme', t);
          } catch (e) {}
        }
        apply();
        if (!window.__themeSwap) {
          window.__themeSwap = true;
          document.addEventListener('astro:before-swap', function (ev) {
            apply(ev.newDocument);
          });
        }
      })();
    </script>
  </head>
  <body>
    <div class="bg-image" aria-hidden="true" transition:persist></div>
    <div class="bg-overlay" aria-hidden="true" transition:persist></div>
    <Snow />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ClickRipple />
    <BackToTop />
    <script>
      const map: Record<string, string> = {
        cpp: 'C++',
        c: 'C',
        cs: 'C#',
        csharp: 'C#',
        python: 'Python',
        py: 'Python',
        js: 'JavaScript',
        javascript: 'JavaScript',
        ts: 'TypeScript',
        typescript: 'TypeScript',
        java: 'Java',
        go: 'Go',
        rust: 'Rust',
        bash: 'Bash',
        sh: 'Shell',
        shell: 'Shell',
        html: 'HTML',
        css: 'CSS',
        json: 'JSON',
        yaml: 'YAML',
        yml: 'YAML',
        sql: 'SQL',
        kotlin: 'Kotlin',
        php: 'PHP',
        ruby: 'Ruby',
        plaintext: 'Text',
        text: 'Text',
      };
      const extMap: Record<string, string> = {
        cpp: 'cpp',
        c: 'c',
        cs: 'cs',
        csharp: 'cs',
        python: 'py',
        py: 'py',
        js: 'js',
        javascript: 'js',
        ts: 'ts',
        typescript: 'ts',
        java: 'java',
        go: 'go',
        rust: 'rs',
        bash: 'sh',
        sh: 'sh',
        shell: 'sh',
        html: 'html',
        css: 'css',
        json: 'json',
        yaml: 'yml',
        yml: 'yml',
        sql: 'sql',
        kotlin: 'kt',
        php: 'php',
        ruby: 'rb',
        plaintext: 'txt',
        text: 'txt',
      };
      function wrapCode() {
        document.querySelectorAll('pre.astro-code').forEach((pre) => {
          if (pre.dataset.cb) return;
          pre.dataset.cb = '1';
          const lang = pre.getAttribute('data-language') || '';
          const label = map[lang] || (lang ? lang.toUpperCase() : 'Code');
          const wrap = document.createElement('div');
          wrap.className = 'code-block';
          const header = document.createElement('div');
          header.className = 'code-header';
          const span = document.createElement('span');
          span.className = 'code-lang';
          span.textContent = label;
          const actions = document.createElement('div');
          actions.className = 'code-actions';
          const dl = document.createElement('button');
          dl.type = 'button';
          dl.className = 'code-download';
          dl.setAttribute('aria-label', 'Tải mã về máy');
          dl.title = 'Tải mã về máy';
          dl.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>';
          dl.addEventListener('click', () => {
            const code = pre.querySelector('code')?.innerText ?? '';
            const ext = extMap[lang] || 'txt';
            const blob = new Blob([code], { type: 'text/plain;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `code.${ext}`;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
          });
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy';
          btn.setAttribute('aria-label', 'Sao chép mã');
          btn.textContent = 'Copy';
          btn.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.innerText ?? '';
            try {
              await navigator.clipboard.writeText(code);
              btn.textContent = 'Đã chép ✓';
              setTimeout(() => (btn.textContent = 'Copy'), 1500);
            } catch {
              btn.textContent = 'Lỗi';
              setTimeout(() => (btn.textContent = 'Copy'), 1500);
            }
          });
          header.appendChild(span);
          actions.appendChild(dl);
          actions.appendChild(btn);
          header.appendChild(actions);
          pre.parentNode?.insertBefore(wrap, pre);
          wrap.appendChild(header);
          wrap.appendChild(pre);
        });
      }
      function wrapIO() {
        document.querySelectorAll<HTMLElement>('.io').forEach((el) => {
          if (el.dataset.ioInit) return;
          el.dataset.ioInit = '1';
          const pre = el.querySelector('pre');
          if (!pre) return;
          const bar = document.createElement('div');
          bar.className = 'io-bar';
          const lab = document.createElement('span');
          lab.className = 'io-label';
          lab.textContent = el.getAttribute('data-io') || 'Input';
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'io-copy';
          btn.textContent = 'Copy';
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(pre.innerText);
              btn.textContent = 'Đã chép ✓';
              setTimeout(() => (btn.textContent = 'Copy'), 1500);
            } catch {
              btn.textContent = 'Lỗi';
              setTimeout(() => (btn.textContent = 'Copy'), 1500);
            }
          });
          bar.appendChild(lab);
          bar.appendChild(btn);
          el.insertBefore(bar, pre);
        });
      }
      if (!(window as any).__cbInit) {
        (window as any).__cbInit = true;
        document.addEventListener('astro:page-load', () => {
          wrapCode();
          wrapIO();
        });
      }
    </script>
  </body>
</html>
