---
import Base from '../../layouts/Base.astro';
import { getAllPosts, groupPostsByYear, formatDate } from '../../utils';

const posts = await getAllPosts();
const groups = groupPostsByYear(posts);
const total = posts.length;
---

<Base title="Lưu trữ" description="Tất cả bài viết theo năm.">
  <div class="container">
    <div class="page-wrap">
      <h1 class="page-title">Lưu trữ</h1>
      <p class="page-sub">{total} bài viết</p>
      {
        groups.map((g) => (
          <section class="archive-group">
            <h2 class="archive-year">{g.year}</h2>
            <div class="archive-items">
              {g.posts.map((p) => (
                <div class="archive-item">
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  <a href={`/posts/${p.id}/`}>{p.data.title}</a>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>
