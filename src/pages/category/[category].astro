---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts, slugify, capitalize } from '../../utils';

export const getStaticPaths = (async () => {
  const posts = await getAllPosts();
  const map = new Map<string, { name: string; posts: typeof posts }>();
  for (const p of posts)
    for (const c of p.data.category) {
      const slug = slugify(c);
      const entry = map.get(slug);
      if (entry) entry.posts.push(p);
      else map.set(slug, { name: c, posts: [p] });
    }
  return [...map.entries()].map(([slug, { name, posts }]) => ({
    params: { category: slug },
    props: { name, posts },
  }));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props;
const label = capitalize(name);
---

<Base title={`Chủ đề: ${label}`} description={`Bài viết thuộc chủ đề ${label}.`}>
  <div class="container">
    <div class="page-wrap">
      <h1 class="page-title">{label}</h1>
      <p class="page-sub">{posts.length} bài viết</p>
      <div class="post-list">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </div>
</Base>
