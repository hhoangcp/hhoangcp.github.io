---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Avatar from '../components/Avatar.astro';
import { getAllPosts } from '../utils';
import { SITE } from '../consts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getAllPosts();
  return paginate(posts, { pageSize: SITE.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const pageHref = (n: number) => (n === 1 ? '/' : `/${n}/`);
---

<Base title={page.currentPage > 1 ? `Trang ${page.currentPage}` : undefined}>
  <div class="container">
    {
      page.currentPage === 1 && (
        <section class="hero">
          <Avatar size={80} />
          <div class="hero-text">
            <h1>{SITE.title}</h1>
            <p>{SITE.description}</p>
          </div>
        </section>
      )
    }
    <div class="post-list">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>
    {
      page.lastPage > 1 && (
        <nav class="pagination" aria-label="Phân trang">
          {page.url.prev && (
            <a href={page.url.prev} rel="prev">
              ← Trước
            </a>
          )}
          {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
            <a href={pageHref(n)} class={n === page.currentPage ? 'active' : ''}>
              {n}
            </a>
          ))}
          {page.url.next && (
            <a href={page.url.next} rel="next">
              Sau →
            </a>
          )}
        </nav>
      )
    }
  </div>
</Base>
