---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import Back from '../../components/Back.astro';
import { getAllPosts } from '../../utils';
import { SITE } from '../../consts';

const PAGE_SIZE = SITE.postsPerPage;
const all = await getAllPosts();
const posts = all.slice(0, PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const pageHref = (n: number) => (n === 1 ? '/posts/' : `/posts/page/${n}/`);
---

<Base title="Bài viết" description="Tất cả bài viết.">
  <div class="container">
    <div class="page-wrap">
      <Back href="/" />
      <h1 class="page-title">Bài viết</h1>
      <p class="page-sub">{all.length} bài viết</p>
      <div class="post-list">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <Pagination page={1} lastPage={lastPage} pageHref={pageHref} />
    </div>
  </div>
</Base>
